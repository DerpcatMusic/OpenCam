<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
 <include android:id="@+id/summary" layout="@layout/camera_summary" android:layout_width="0dp" android:layout_height="wrap_content"
  app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
 <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/camera_body" android:layout_width="0dp" android:layout_height="0dp"
  app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
  app:layout_constraintTop_toBottomOf="@id/summary" app:layout_constraintBottom_toBottomOf="parent">
 <include android:id="@+id/preview_stage" layout="@layout/preview_stage" android:layout_width="0dp" android:layout_height="0dp"
  android:layout_marginTop="@dimen/content_gutter" android:layout_marginBottom="@dimen/content_gutter"
  app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/tool_scroll" />
 <!-- Bound overflow to a share of the available body; ordinary tool height remains content-measured. -->
 <androidx.constraintlayout.widget.Guideline android:id="@+id/tool_overflow_limit" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:orientation="horizontal" app:layout_constraintGuide_percent="0.5" />
 <androidx.core.widget.NestedScrollView android:id="@+id/tool_scroll" android:layout_width="0dp" android:layout_height="wrap_content"
  android:fillViewport="false" app:layout_constrainedHeight="true" app:layout_constraintVertical_bias="1"
  app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
  app:layout_constraintTop_toTopOf="@id/tool_overflow_limit" app:layout_constraintBottom_toBottomOf="parent">
  <include layout="@layout/camera_toolbar" />
 </androidx.core.widget.NestedScrollView>
 </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
